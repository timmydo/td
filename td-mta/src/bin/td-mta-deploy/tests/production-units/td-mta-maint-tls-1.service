[Unit]
Description=td-mta-maint-tls-1

[Service]
User=td-mta
Group=td-mta
ProtectSystem=strict
ProtectHome=yes
MemoryMax=512M
TasksMax=32
Type=oneshot
ExecStart=:"/usr/bin/openssl" "x509" "-in" "/var/lib/td-mta/mail/tls/ca.pem" "-noout" "-checkend" "2592000"
UMask=0077
TimeoutStartSec=120
NoNewPrivileges=yes
PrivateTmp=yes
