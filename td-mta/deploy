#!/usr/bin/env python3
"""Build and deploy a checked main revision to claw1."""
import argparse
import io
import json
import os
from pathlib import Path
import re
import shlex
import subprocess
import sys
import time
import zipfile

ROOT = Path(__file__).resolve().parents[1]
REMOTE = 'timmy@172.179.0.6'
SSH = ['ssh', '-T', '-oBatchMode=yes', '-oStrictHostKeyChecking=yes',
       '-oIdentitiesOnly=yes', '-oConnectTimeout=10', '-i',
       str(Path.home()/'.ssh/td_mta_systemd_test')]
OPERATOR = '/var/lib/td-mta-operator'
GIT = '/home/timmy/src/td'


def run(args, **kw):
    return subprocess.run(args, cwd=ROOT, check=True, **kw)


def output(args):
    return run(args, stdout=subprocess.PIPE, text=True).stdout.strip()


def ssh(*args):
    return SSH + [REMOTE, shlex.join([str(arg) for arg in args])]


def revision(value):
    if not re.fullmatch('[0-9a-f]{40}', value):
        raise ValueError('invalid revision')
    return value


def select(tip, live):
    run(['git', 'merge-base', '--is-ancestor', live, tip])
    state = Path(os.environ.get('TD_MAIN_INTEGRATION_DIR',
                 Path.home()/'.local/state/td/main-integration'))/'verdicts'
    revisions = output(['git', 'rev-list', '--first-parent', tip, '^'+live]).splitlines()
    for candidate in revisions:
        if subprocess.run(['git', 'merge-base', '--is-ancestor', live, candidate], cwd=ROOT).returncode != 0:
            continue
        verdict = state/revision(candidate)
        if verdict.is_file():
            row = verdict.read_text().split()
            if len(row) == 4 and row[:2] == ['pass', '0'] and all(n.isdecimal() for n in row[2:]):
                return candidate, ' '.join(row)
    if revisions:
        print('No newer landed revision has a passing main-integration verdict. '
              'Checking the deployed release.', flush=True)
    return live, None


def public_jmap(account):
    def client(requests):
        reply = run(['td-mail', '--cli'], input=''.join(json.dumps(q)+'\n' for q in requests),
                    text=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=30)
        rows = [json.loads(line) for line in reply.stdout.splitlines() if line.startswith('{')]
        if len(rows) != len(requests) or not all(row.get('ok') for row in rows):
            raise ValueError('public authenticated JMAP qualification failed')
        return rows

    accounts = client([dict(command='list_accounts')])[0]['accounts']
    origins = {'https://'+host+'/.well-known/jmap' for host in
               ('mx.timmydouglas.com','mx.timmyd.info','mx.882015.xyz')}
    if not any(a['name']==account and a.get('well_known_url') in origins for a in accounts):
        raise ValueError('td-mail account must use a production HTTPS discovery URL')
    rows = client([dict(command='connect', account=account), dict(command='list_mailboxes')])
    if not rows[-1].get('mailboxes'):
        raise ValueError('public production JMAP returned no mailboxes')
    return time.time()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--window-seconds', type=int, default=60)
    parser.add_argument('--jmap-account', default='xyz882015', help='production td-mail account on this machine')
    opts = parser.parse_args()
    if not 1 <= opts.window_seconds <= 3600:
        parser.error('window must be 1..3600 seconds')
    run(['git', 'fetch', '--no-tags', 'origin', 'refs/heads/main'])
    controller = revision(output(['git','rev-parse','HEAD^{commit}']))
    run(['git','diff','--quiet',controller,'--','td-mta/deploy','td-mta/ops'])
    refs = output(['git','for-each-ref','--contains',controller,'--format=%(refname)',
                   'refs/remotes/origin/'])
    if not refs:
        raise ValueError('deployment tool revision has not been submitted to origin')
    tip = revision(output(['git', 'rev-parse', 'FETCH_HEAD^{commit}']))
    live_path = output(ssh('readlink', '-f', '/opt/td-mta/bin/td-mta'))
    match = re.fullmatch('/opt/td-mta/lib/td-mta/releases/git-([0-9a-f]{40})/td-mta', live_path)
    if not match:
        raise ValueError('unrecognized production release')
    live = match[1]
    selected, verdict = select(tip, live)
    tree = revision(output(['git', 'rev-parse', selected+'^{tree}']))
    print(f'claw1 current {live}, selected {selected}', flush=True)
    jmap_before = public_jmap(opts.jmap_account)
    if selected != live:
        # The production mirror can lag behind the development machine.
        env = dict(os.environ, GIT_SSH_COMMAND=shlex.join(SSH))
        run(['git', 'push', '--no-follow-tags', REMOTE+':'+GIT,
             selected+':refs/td-mta-deploy/'+selected], env=env)
    code = io.BytesIO()
    with zipfile.ZipFile(code, 'w', zipfile.ZIP_DEFLATED) as z:
        for src, dest in [('activate.py','__main__.py'), ('physical.py','physical.py')]:
            blob=run(['git','show',controller+':td-mta/ops/'+src],stdout=subprocess.PIPE).stdout
            z.writestr(dest,blob)
        z.writestr('job.json', json.dumps(dict(previous=live, revision=selected,
                   tree=tree, controller=controller, verdict=verdict, main=tip, budget=opts.window_seconds)))
    job = output(ssh('sudo','-n','mktemp','-d',OPERATOR+'/deploy-XXXXXXXX'))
    if not re.fullmatch(OPERATOR+r'/deploy-[a-zA-Z0-9]{8}', job):
        raise ValueError('unexpected deployment directory')
    run(ssh('sudo','-n','install','-m','0600','/dev/stdin',job+'/deploy.pyz'),
        input=code.getvalue())
    print('Production receipt: '+job+'/receipt.json', flush=True)
    external = dict(check='authenticated public JMAP Mailbox/get', before=jmap_before,
                    revision=selected, job='pending', after_result='pending')
    def save_probe():
        run(ssh('sudo','-n','install','-m','0600','/dev/stdin',job+'/public-jmap.pending'),
            input=json.dumps(external).encode())
        run(ssh('sudo','-n','mv','-T',job+'/public-jmap.pending',job+'/public-jmap.json'))
        run(ssh('sudo','-n','sync','-f',job))
    save_probe()
    # systemd owns the job through an SSH interruption.
    status = subprocess.run(ssh('sudo','-n','systemd-run','--wait','--collect','--quiet',
            '--unit=td-mta-'+Path(job).name,'--property=UMask=0077',
            '--property=TimeoutStopSec=360','--property=KillMode=mixed',
            '--property=WorkingDirectory='+job,'/usr/bin/python3','-I',job+'/deploy.pyz')).returncode
    external['job'] = 'unknown' if status==255 else ('failed' if status else 'succeeded')
    try:
        external['after']=public_jmap(opts.jmap_account)
        external['after_result']='passed'
    except (OSError, ValueError, subprocess.SubprocessError):
        external.update(after=time.time(),after_result='failed')
    save_probe()
    print(output(ssh('sudo','-n','cat',job+'/receipt.json')))
    if status:
        raise SystemExit(status)
    if external['after_result']!='passed':
        raise ValueError('post-deployment public JMAP qualification failed')


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        sys.exit(str(error))
