# Per-rung scratch dirs; kept on a red run for triage, removed on green.
.run-scratch/
.store-register-scratch/
.store-add-scratch/
.store-add-tree-scratch/
.store-gc-scratch/
.store-gc-sweep-scratch/
.store-verify-scratch/
.store-add-referenced-scratch/
.build-hermetic-scratch/
.build-daemon-scratch/
# cargo-test: scratch CARGO_HOME + CARGO_TARGET_DIR (clean compile each run).
.cargo-test-scratch/
# recipe-rs: scratch CARGO_HOME + CARGO_TARGET_DIR + a local `cargo build` target.
.recipe-rs-scratch/
# Engine workspace `cargo build` output — builder/recipes/engine now share ONE
# target dir at the workspace root (was recipes/target/ + builder/target/).
/target/

# Standalone test-fixture crates (tests/sshd, …) each build to their own target
# dir when compiled directly on the host for validation.
tests/*/target/

# check-memo verdicts (constraint 2): host-local state,
# NEVER committed — a verdict greens only the environment that recorded it.
.check-verdicts/

# td-check-repro verdicts: same host-local, never-committed
# rule — memoizes the td-builder check double-build (kept separate from
# .check-verdicts/ to avoid the per-drv verdict-filename collision).
.td-check-verdicts/

.store-backend-scratch/

# Gate commit-lock files: a sibling `.commit.lock` to whatever scratch dir a gate
# points a store db at, written during a gate run. Matched on the SUFFIX rather than
# a per-gate prefix — `store-backend`/`store-verify` were not the only gates that
# leave one (`toolchain-input-addressed` does too), and a prefix list is a file that
# gets committed by accident the first time a new gate appears. Host-local, never
# versioned.
.*-scratch.commit.lock

# Persistent content-addressed build-recipe cache (skip-if-already-realized).
.td-build-cache

# Ad-hoc captured `td-builder check` run logs (e.g. a backgrounded full-loop run). Transient
# host-local output, never versioned.
.check-*.log

# Retired daily-backstop runner state. No code writes these any more (the runner
# is gone); the entries stay so a stale file left on an existing dev host is not
# surfaced as untracked — affected-checks counts untracked paths.
.td-last-green
.td-daily-verdict

# Claude Code session runtime state — session-specific, never versioned.
.claude/scheduled_tasks.lock

# td-review: the host-side integrator TUI is built locally, not by a recipe.
td-review/target/

# td-firstboot: shipped by its recipe as a direct rustc build, but compiled here
# too by the cargo-test gate and by hand when validating provisioning.
td-firstboot/target/

# td-txt: the grep/sed multicall is built directly (cargo, or by rustc in its
# recipe) during development; the shared gate redirects CARGO_TARGET_DIR to a
# scratch dir instead.
td-txt/target/

# td-svc: same — the supervisor is built directly while developing, and by
# rustc in its recipe; the gate uses a scratch CARGO_TARGET_DIR.
td-svc/target/

# td-login: same — the credential multicall is shipped by its recipe as a direct
# rustc build, but compiled here by the cargo-test gate and by hand when
# validating the login chain.
td-login/target/

# td-install: the installer is built directly while developing and by the
# cargo-test gate, which redirects CARGO_TARGET_DIR to a scratch dir.
td-install/target/

# td's minimal graphical stack is built directly during development and by
# rustc in its recipes; the gate uses a scratch CARGO_TARGET_DIR.
td-compositor/target/
td-seatd/target/

# td-profiler: built in-tree by the HOST preflight (`td-builder
# affected-checks --run`), which unlike the 325-cargo-test gate neither sets
# nor clears CARGO_TARGET_DIR -- it inherits whatever the caller has, so with
# no override it writes here. Without this line the preflight's own build
# leaves the output untracked, and `ready` refuses every LATER run over paths
# that route to a check.
td-profiler/target/
