# Cell rendition and color are observable state, not renderer policy.

case color/indexed-and-rgb
source td
tags core color
size 1 4
write b"\e[1;4;38;5;196;48;2;1;2;3mX"
expect cell 0 0 "X" fg=indexed:196 bg=rgb:010203 attrs=bold,underline
write b"\e[0mY"
expect cell 0 1 "Y" fg=default bg=default attrs=none
end

case color/bright-and-reset
source td
tags core color
size 1 4
write b"\e[94;103mA\e[39;49mB"
expect cell 0 0 "A" fg=indexed:12 bg=indexed:11 attrs=none
expect cell 0 1 "B" fg=default bg=default attrs=none
end

case color/incomplete-rgb-does-not-leak-operands
source td
tags core color
size 1 1
write b"\e[38;2;1;4mX"
expect cell 0 0 "X" fg=default bg=default attrs=none
end

case color/erase-retains-only-colors
source td
tags core color editing
size 1 2
write b"\e[1;4;31;44mX\e[2K"
expect cell 0 0 " " fg=indexed:1 bg=indexed:4 attrs=none
expect cell 0 1 " " fg=indexed:1 bg=indexed:4 attrs=none
end

case color/ignored-color-forms-do-not-leak-operands
source td
tags core color bounds
size 1 4
write b"\e[58;2;1;4;7mA\e[58;5;9mB\e[38;9mC\e[38:2::1:2:3mD"
expect cell 0 0 "A" fg=default bg=default attrs=none
expect cell 0 1 "B" fg=default bg=default attrs=none
expect cell 0 2 "C" fg=default bg=default attrs=none
expect cell 0 3 "D" fg=default bg=default attrs=none
end

# The rendition attributes and their individual resets. Bold and italic and
# underline were reachable only through cases asserting something else, and
# faint, inverse, strike and the 22/23/24/27/29 resets were pinned nowhere at
# all. td-term's terminfo entry names this case for every set/reset pair it
# claims.
case color/rendition-set-and-reset
source td
tags core color
size 1 12
write b"\e[1mA\e[22mB\e[2mC\e[22mD\e[3mE\e[23mF"
write b"\e[4mG\e[24mH\e[7mI\e[27mJ\e[9mK\e[29mL"
expect cell 0 0 "A" fg=default bg=default attrs=bold
expect cell 0 1 "B" fg=default bg=default attrs=none
expect cell 0 2 "C" fg=default bg=default attrs=faint
expect cell 0 3 "D" fg=default bg=default attrs=none
expect cell 0 4 "E" fg=default bg=default attrs=italic
expect cell 0 5 "F" fg=default bg=default attrs=none
expect cell 0 6 "G" fg=default bg=default attrs=underline
expect cell 0 7 "H" fg=default bg=default attrs=none
expect cell 0 8 "I" fg=default bg=default attrs=inverse
expect cell 0 9 "J" fg=default bg=default attrs=none
expect cell 0 10 "K" fg=default bg=default attrs=strike
expect cell 0 11 "L" fg=default bg=default attrs=none
end

# The palette background form. `48;2` (RGB) was covered; `48;5` was not, so
# nothing pinned indexed background selection. td-term's `setab` names it.
case color/indexed-palette-background
source td
tags core color
size 1 2
write b"\e[38;5;33;48;5;99mX"
expect cell 0 0 "X" fg=indexed:33 bg=indexed:99 attrs=none
write b"\e[39;49mY"
expect cell 0 1 "Y" fg=default bg=default attrs=none
end
