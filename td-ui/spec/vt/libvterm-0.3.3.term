case libvterm/63screen-resize/resize-can-operate-on-altscreen
source "libvterm-0.3.3:t/63screen_resize.test:109:Resize can operate on altscreen"
tags core resize
size 20 80
resize 25 80
write b"Main screen\e[?1049h\e[HAlt screen"
expect reply b""
resize 30 80
expect text 0 "Alt screen                                                                      "
write b"\e[?1049l"
expect reply b""
expect text 0 "Main screen                                                                     "
end

case libvterm/63screen-resize/resize-shorter-does-not-lose-line-with-cursor
source "libvterm-0.3.3:t/63screen_resize.test:57:Resize shorter does not lose line with cursor"
tags core resize
size 20 80
resize 25 80
write b"\e[24HLine 24\r\nLine 25\r\n"
expect cursor 24 0
expect reply b""
expect text 23 "Line 25                                                                         "
resize 24 80
expect cursor 23 0
expect text 22 "Line 25                                                                         "
end

case libvterm/63screen-resize/resize-shorter-does-not-send-the-cursor-to-a-negative-row
source "libvterm-0.3.3:t/63screen_resize.test:72:Resize shorter does not send the cursor to a negative row"
tags core resize
size 24 80
resize 25 80
write b"\e[24HLine 24\r\nLine 25\e[H"
expect cursor 0 0
expect reply b""
resize 20 80
expect cursor 0 0
end

case libvterm/63screen-resize/resize-shorter-with-blanks-just-truncates
source "libvterm-0.3.3:t/63screen_resize.test:27:Resize shorter with blanks just truncates"
tags core resize
size 25 100
resize 25 80
write b"Top\e[10HLine 10"
expect cursor 9 7
expect reply b""
expect text 0 "Top                                                                             "
expect text 9 "Line 10                                                                         "
resize 20 80
expect cursor 9 7
expect text 0 "Top                                                                             "
expect text 9 "Line 10                                                                         "
end

case libvterm/63screen-resize/resize-shorter-with-content-must-scroll
source "libvterm-0.3.3:t/63screen_resize.test:39:Resize shorter with content must scroll"
tags core resize
size 20 80
resize 25 80
write b"Top\e[25HLine 25\e[15H"
expect cursor 14 0
expect reply b""
expect text 0 "Top                                                                             "
expect text 24 "Line 25                                                                         "
resize 20 80
expect cursor 9 0
expect text 0 "                                                                                "
expect text 19 "Line 25                                                                         "
end

