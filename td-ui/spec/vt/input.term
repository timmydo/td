# td-term keyboard adapter cases.
#
# `key` runs one press through the adapter with the terminal's current modes;
# `expect input` names the complete generated byte stream since initialization.
# Nothing here writes to the terminal except to select a mode, so these cases
# observe the keyboard side alone, before the PTY writer merges it with replies.

case input/text-and-shift-levels
source td
tags core input
size 2 8
key h
key shift+i
key space
key 1
key shift+1
expect input b"hI 1!"
expect row 0 "        "
expect cursor 0 0
end

case input/caps-lock-reaches-letters-only
source td
tags core input
size 2 8
key caps+a
key caps+shift+a
key caps+1
expect input b"Aa1"
end

case input/control-produces-c0-bytes
source td
tags core input
size 2 8
key ctrl+c
key ctrl+d
key ctrl+space
key ctrl+leftbracket
key ctrl+shift+6
key ctrl+shift+minus
key ctrl+shift+slash
expect input b"\x03\x04\x00\x1b\x1e\x1f\x7f"
end

case input/alt-prefixes-with-escape
source td
tags core input
size 2 8
key alt+a
key alt+ctrl+c
key alt+backspace
expect input b"\x1ba\x1b\x03\x1b\x7f"
end

case input/named-keys-use-terminal-bytes
source td
tags core input
size 2 8
key enter
key tab
key shift+tab
key backspace
key escape
key insert
key delete
expect input b"\r\t\x1b[Z\x7f\x1b\x1b[2~\x1b[3~"
end

# Shift is not silent everywhere. The fixed keys have one spelling at both
# levels and pass it through, as real terminals do; the navigation and function
# keys have no shifted spelling here and are silent.
case input/shift-passes-through-fixed-keys
source td
tags core input
size 2 8
key shift+enter
key shift+backspace
key shift+escape
key shift+kpenter
key shift+up
key shift+home
key shift+f1
key shift+delete
expect input b"\r\x7f\x1b\r"
end

case input/function-keys
source td
tags core input
size 2 8
key f1
key f2
key f3
key f4
key f5
key f6
key f7
key f8
key f9
key f10
key f11
key f12
expect input b"\x1bOP\x1bOQ\x1bOR\x1bOS\x1b[15~\x1b[17~\x1b[18~\x1b[19~\x1b[20~\x1b[21~\x1b[23~\x1b[24~"
end

# DECCKM selects the SS3 spelling for cursor and edge keys. The write below is
# the only thing that changes the terminal here, so the adapter's answer follows
# a mode the case established rather than one it was told.
case input/cursor-keys-follow-application-mode
source td
tags core input modes
size 2 8
key up
key down
key left
key right
key home
key end
expect input b"\x1b[A\x1b[B\x1b[D\x1b[C\x1b[H\x1b[F"
expect mode application-cursor off
write b"\x1b[?1h"
expect mode application-cursor on
key up
key down
key left
key right
key home
key end
expect input b"\x1b[A\x1b[B\x1b[D\x1b[C\x1b[H\x1b[F\x1bOA\x1bOB\x1bOD\x1bOC\x1bOH\x1bOF"
write b"\x1b[?1l"
key up
expect input b"\x1b[A\x1b[B\x1b[D\x1b[C\x1b[H\x1b[F\x1bOA\x1bOB\x1bOD\x1bOC\x1bOH\x1bOF\x1b[A"
end

# Paging keys never change spelling, and their shifted forms belong to the
# scrollback viewport rather than to the child.
case input/paging-keys-are-mode-independent
source td
tags core input modes
size 2 8
key pageup
key pagedown
write b"\x1b[?1h"
key pageup
key shift+pageup
key shift+pagedown
expect input b"\x1b[5~\x1b[6~\x1b[5~"
end

# The compositor forwards Super chords it has no binding for, so a modifier
# this profile does not translate must make the whole chord unlisted rather
# than a bare keypress. Otherwise Super+q types q. td's own compositor keeps
# super+enter and super+up, so those two cases are about any OTHER compositor
# that forwards them: the rule is the profile's and does not shrink as one
# compositor's table grows.
case input/an-untranslated-modifier-silences-the-chord
source td
tags core input
size 2 8
key super+q
key super+enter
key super+up
key super+ctrl+c
key super+space
key q
expect input b"q"
end

# Every unlisted combination is silent rather than guessed: a modified-key
# encoding this profile does not claim would be indistinguishable from one it
# does. Modifier keys themselves are never text.
case input/unlisted-combinations-are-silent
source td
tags core input
size 2 8
key ctrl+up
key ctrl+f1
key ctrl+insert
key ctrl+enter
key shift+up
key shift+f1
key shift+insert
key leftshift
key leftcontrol
key leftmeta
key capslock
key print
key menu
key a
expect input b"a"
end

# The keypad is digits-only in this profile: Num Lock state is reported by the
# compositor but does not select navigation symbols.
case input/keypad-is-digits-only
source td
tags core input
size 2 8
key kp7
key kp0
key kpperiod
key kpenter
key kpplus
key kpminus
expect input b"70.\r+-"
end

# The adapter and the terminal are separate sources: keys generate input, the
# terminal generates replies, and neither appears in the other's stream.
case input/keyboard-and-replies-are-separate-streams
source td
tags core input replies
size 2 8
key a
write b"\x1b[6n"
expect input b"a"
expect reply b"\x1b[1;1R"
key b
expect input b"ab"
expect reply b"\x1b[1;1R"
end

# Alt is a prefix applied after the level is chosen, so it composes with the
# one Shift variant a fixed key defines rather than cancelling it.
case input/alt-composes-with-the-shift-variant
source td
tags core input
size 2 8
key tab
expect input b"\t"
key shift+tab
expect input b"\t\x1b[Z"
key alt+shift+tab
expect input b"\t\x1b[Z\x1b\x1b[Z"
end

# Ctrl reads the level Shift selected, but Caps Lock never changes which C0
# byte comes out: Ctrl+A and Ctrl+Shift+A are both SOH.
case input/caps-does-not-change-the-control-byte
source td
tags core input
size 2 8
key ctrl+a
expect input b"\x01"
key ctrl+caps+a
expect input b"\x01\x01"
key ctrl+shift+a
expect input b"\x01\x01\x01"
end

# Ctrl over a key whose level has no C0 spelling is silent, not the bare
# character: the profile claims the specified table and nothing besides.
case input/control-without-a-c0-spelling-is-silent
source td
tags core input
size 2 8
key ctrl+1
expect input b""
key ctrl+comma
expect input b""
key ctrl+period
expect input b""
key ctrl+f1
expect input b""
key ctrl+a
expect input b"\x01"
end

# Shift+PageUp and Shift+PageDown move td-term's own viewport a screen less
# one row at a time, so the line last read is still on screen to read on
# from. Neither reaches the child, and both stop at the ends.
case input/scrollback-shift-paging-moves-the-viewport
source td
tags core input scrollback
size 2 8
write b"1\r\n2\r\n3\r\n4"
expect viewport 0
key shift+pageup
expect viewport 1
key shift+pageup
expect viewport 2
key shift+pageup
expect viewport 2
key shift+pagedown
expect viewport 1
key shift+pagedown
expect viewport 0
key shift+pagedown
expect viewport 0
expect input b""
end

# End has two meanings and the state at the moment of the press picks one:
# at the live bottom it is the child's, and while viewing scrollback it is
# consumed to return there.
case input/scrollback-end-returns-to-the-live-bottom
source td
tags core input scrollback
size 2 8
write b"1\r\n2\r\n3\r\n4"
key end
expect input b"\x1b[F"
key shift+pageup
expect viewport 1
key end
expect viewport 0
expect input b"\x1b[F"
key end
expect input b"\x1b[F\x1b[F"
end

# Ordinary input returns to the live bottom: the child cannot answer a key
# whose answer the reader would not be looking at.
case input/scrollback-ordinary-input-returns-to-the-bottom
source td
tags core input scrollback
size 2 8
write b"1\r\n2\r\n3\r\n4"
key shift+pageup
expect viewport 1
key a
expect viewport 0
expect input b"a"
end

# A key this profile does not translate leaves the viewport where it is: it
# is neither input nor a scroll, so it must not close the view.
case input/scrollback-a-silent-key-leaves-the-view
source td
tags core input scrollback
size 2 8
write b"1\r\n2\r\n3\r\n4"
key shift+pageup
expect viewport 1
key print
key super+q
key ctrl+shift+pageup
key alt+shift+pageup
expect viewport 1
expect input b""
end

# Output arriving under an open viewport must not drag the view along with
# it. The line being read is named in a numbering eviction and scrolling do
# not renumber, so its distance from the live bottom grows instead.
case input/scrollback-output-does-not-drag-the-view
source td
tags core input scrollback
size 2 8
write b"1\r\n2\r\n3\r\n4"
key shift+pageup
expect viewport 1
write b"\r\n5"
expect viewport 2
write b"\r\n6"
expect viewport 3
end

# A reset clears the history a viewport was anchored in, so the view has
# nowhere to be but the live bottom.
case input/scrollback-a-reset-closes-the-view
source td
tags core input scrollback
size 2 8
write b"1\r\n2\r\n3\r\n4"
key shift+pageup
expect viewport 1
write b"\x1bc"
expect viewport 0
end

# A clear renumbers history from zero, so an anchor from before it names a
# number a later line will also have. The view must not come back as those
# numbers arrive: it was closed by the clear, and the lines it was reading
# no longer exist.
case input/scrollback-a-cleared-history-does-not-reopen-the-view
source td
tags core input scrollback
size 2 8
write b"1\r\n2\r\n3\r\n4"
key shift+pageup
expect viewport 1
write b"\x1bc"
expect viewport 0
write b"5\r\n6\r\n7\r\n8"
expect viewport 0
key shift+pageup
expect viewport 1
end
